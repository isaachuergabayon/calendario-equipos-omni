rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Usuarios: solo puede leer/escribir el propio usuario
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Equipos: cualquier usuario autenticado puede leer y escribir
    match /teams/{teamId} {
      allow read, write: if request.auth != null;
    }

    // Ausencias: cualquier usuario autenticado puede leer todas
    // Solo puede crear/editar/borrar las suyas propias
    match /absences/{absenceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }
  }
}
